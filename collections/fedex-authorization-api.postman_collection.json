      "item": [
        {
          "id": "20d9d197-80d8-4c99-a566-2615a4533fc2",
          "name": "Issue OAuth 2.0 access token",
          "request": {
            "name": "Issue OAuth 2.0 access token",
            "description": {
              "content": "Exchanges FedEx Developer Portal client credentials for an OAuth 2.0\nbearer access token. The returned access token is valid for one hour\nand must be included as a Bearer token on subsequent API calls.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
