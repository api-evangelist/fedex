{
  "opencollection": "1.0.0",
  "info": {
    "name": "FedEx Track Authorization API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue OAuth 2.0 access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apis.fedex.com/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchanges FedEx Developer Portal client credentials for an OAuth 2.0\nbearer access token. The returned access token is valid for one hour\nand must be included as a Bearer token on subsequent API calls.\n"
        }
      ]
    }
  ],
  "bundled": true
}